generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model document {
  id              Int          @id @default(autoincrement())
  profile_info_id Int
  title           String       @db.VarChar(256)
  category        String       @db.VarChar(128)
  description     String?
  external_url    String?      @db.VarChar(1024)
  file_name       String?      @db.VarChar(512)
  file_content    Bytes?
  file_mime_type  String?      @db.VarChar(128)
  issue_date      DateTime?    @db.Date
  profile_info    profile_info @relation(fields: [profile_info_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_document_profile")
}

model education {
  id               Int          @id @default(autoincrement())
  profile_info_id  Int
  institution_name String       @db.VarChar(256)
  qualification    String?      @db.VarChar(256)
  field_of_study   String?      @db.VarChar(256)
  location         String?      @db.VarChar(256)
  start_date       DateTime     @db.Date
  end_date         DateTime?    @db.Date
  description      String?
  profile_info     profile_info @relation(fields: [profile_info_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_education_profile")
}

model profile_info {
  id                 Int               @id @default(autoincrement())
  full_name          String            @db.VarChar(256)
  professional_title String?           @db.VarChar(256)
  email              String?           @db.VarChar(320)
  phone              String?           @db.VarChar(50)
  country            String?           @db.VarChar(128)
  profile_summary    String?
  linkedin_url       String?           @db.VarChar(512)
  xing_url           String?           @db.VarChar(512)
  github_url         String?           @db.VarChar(512)
  photo              Bytes?
  photo_mime_type    String?           @db.VarChar(100)
  document           document[]
  education          education[]
  skill              skill[]
  work_experience    work_experience[]
}

model skill {
  id               Int          @id @default(autoincrement())
  profile_info_id  Int
  name             String       @db.VarChar(256)
  category         String?      @db.VarChar(128)
  level            String?      @db.VarChar(128)
  years_experience Decimal?     @db.Decimal(4, 1)
  profile_info     profile_info @relation(fields: [profile_info_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_skill_profile")
}

model work_experience {
  id              Int          @id @default(autoincrement())
  profile_info_id Int
  company_name    String       @db.VarChar(256)
  job_title       String       @db.VarChar(256)
  location        String       @db.VarChar(256)
  start_date      DateTime     @db.Date
  end_date        DateTime?    @db.Date
  is_current      Boolean      @default(false)
  description     String?
  profile_info    profile_info @relation(fields: [profile_info_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_work_experience_profile")
}

model access_code {
  code          String       @id @db.VarChar(5)
  company       String?      @db.VarChar(256)
  is_admin_code Boolean      @default(false)
  access_log    access_log[]
}

model access_log {
  access_code_code String      @db.VarChar(5)
  access_time      DateTime    @db.Timestamp(6)
  country          String?     @db.VarChar(256)
  city             String?     @db.VarChar
  access_code      access_code @relation(fields: [access_code_code], references: [code], onDelete: Cascade, onUpdate: NoAction, map: "fk_access_code")

  @@id([access_code_code, access_time])
}
